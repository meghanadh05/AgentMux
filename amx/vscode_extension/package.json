{
  "name": "agentmux-amx",
  "displayName": "AgentMux-amx",
  "description": "Save and switch Codex accounts in your normal VS Code window while preserving shared history and settings.",
  "icon": "images/logo.png",
  "version": "0.1.4",
  "publisher": "megdev",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/meghanadh05/AgentMux.git"
  },
  "homepage": "https://github.com/meghanadh05/AgentMux#readme",
  "bugs": {
    "url": "https://github.com/meghanadh05/AgentMux/issues"
  },
  "galleryBanner": {
    "color": "#111111",
    "theme": "dark"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["codex", "accounts", "switcher", "agent"],
  "extensionKind": ["ui"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentmux.switchAccount",
    "onCommand:agentmux.addAccount",
    "onCommand:agentmux.installCli",
    "onCommand:agentmux.refreshStatus",
    "onCommand:agentmux.reloadWindow"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "contributes": {
    "commands": [
      { "command": "agentmux.switchAccount", "title": "AgentMux-amx: Switch Account" },
      { "command": "agentmux.addAccount", "title": "AgentMux-amx: Add Account" },
      { "command": "agentmux.installCli", "title": "AgentMux-amx: Install CLI" },
      { "command": "agentmux.refreshStatus", "title": "AgentMux-amx: Refresh Account Status" },
      { "command": "agentmux.reloadWindow", "title": "AgentMux-amx: Reload Window" }
    ],
    "configuration": {
      "title": "AgentMux-amx",
      "properties": {
        "agentmux.commandPath": {
          "type": "string",
          "default": "amx",
          "description": "Path to the AgentMux-amx CLI executable."
        }
      }
    }
  }
}
